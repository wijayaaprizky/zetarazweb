# ========================================================
# ZETARAZ Knowledge Environment Configuration
# ========================================================

# Database Connection (SQLite for local dev, or PostgreSQL for production Cloud SQL)
DATABASE_URL="file:./dev.db"

# Admin Authentication & Security (Minimal 32 random characters for production)
JWT_SECRET="your-secret-key-change-this-in-production-min-32-chars"
ADMIN_EMAIL="admin@zetaraz.com"
ADMIN_PASSWORD="ChangeMeInProduction2026!"

# ========================================================
# Domain & Hosting Configuration (Firebase App Hosting)
# ========================================================

# Phase 1: Initial Launch on Firebase Default Domain (No custom domain needed)
# NEXT_PUBLIC_SITE_URL="https://<firebase-site-id>.web.app"

# Phase 2: Future Custom Domain Migration (e.g. zetaraz.com)
# When ready to switch, simply set NEXT_PUBLIC_SITE_URL to your custom domain:
# NEXT_PUBLIC_SITE_URL="https://zetaraz.com"

# Optional: Automatic 301 Redirect Target
# Set this to your custom domain after migration to automatically redirect all *.web.app traffic
# CUSTOM_DOMAIN_REDIRECT_TARGET="zetaraz.com"

# Local Development default
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
