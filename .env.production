# Dimuat otomatis oleh Next.js hanya saat `next build` / `next start`
# (menimpa nilai localhost di .env). Berisi nilai publik saja — tidak ada rahasia.
#
# Ubah ke domain final (mis. https://zetaraz.com) bila sudah memakai domain sendiri.
# Variabel NEXT_PUBLIC_SITE_URL di dashboard Vercel, bila diisi, tetap diutamakan.
NEXT_PUBLIC_SITE_URL="https://zetarazweb.vercel.app"
